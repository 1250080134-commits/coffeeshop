{
  "name": "fondo-server",
  "version": "1.0.0",
  "description": "Backend API for Fondo specialty coffee platform",
  "main": "app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start":            "NODE_ENV=production node app.js",
    "dev":              "nodemon app.js",
    "db:migrate":       "npx sequelize-cli db:migrate",
    "db:migrate:undo":  "npx sequelize-cli db:migrate:undo:all",
    "db:seed":          "node seeders/seed.js",
    "db:setup":         "npx sequelize-cli db:migrate && node seeders/seed.js",
    "db:reset":         "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && node seeders/seed.js"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.5",
    "express":            "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator":  "^7.1.0",
    "helmet":             "^7.1.0",
    "jsonwebtoken":       "^9.0.2",
    "mysql2":             "^3.9.3",
    "sequelize":          "^6.37.2"
  },
  "devDependencies": {
    "nodemon":       "^3.1.0",
    "sequelize-cli": "^6.6.2"
  }
}
